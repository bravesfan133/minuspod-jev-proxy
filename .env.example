# Copy to .env and fill in. Never commit real keys.
# Listening port
PORT=8787

# Primary Jev backend: TypeSafe direct (reliable quota; needs your key).
# Model jev-latest always tracks the newest release.
JEV_PRIMARY_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_PRIMARY_MODEL=jev-latest
JEV_PRIMARY_API_KEY=
# TYPESAFE_API_KEY is also accepted as a fallback name.

# Secondary Jev backend: OpenCode Zen (jev-1.13-free is free and keyless;
# used only if primary fails or rate-limits).
JEV_SECONDARY_BASE_URL=https://opencode.ai/zen/v1/systemone
JEV_SECONDARY_MODEL=jev-1.13-free
JEV_SECONDARY_API_KEY=

# Per-backend timeout
JEV_TIMEOUT_SECS=60

# Classification thresholds (conservative: precision over recall).
# Segment is an ad only if noul >= threshold AND the choice is ad-ish.
JEV_AD_THRESHOLD=0.6
# Reviewer confirms the candidate if noul >= threshold, else rejects it.
JEV_REVIEW_THRESHOLD=0.5

# Transcript grouping / batching / concurrency.
# Max parallel Jev calls: MinusPod fires all windows at once, so this plus
# backoff is what keeps free-tier backends from burst-limiting.
JEV_SEGMENT_TARGET_SECS=30
JEV_MAX_SEGMENTS_PER_CALL=16
JEV_MAX_CONCURRENT_REQS=4

# L2 edge pass: split run boundary blocks into pieces and re-ask Jev per
# piece with tight local context. Shrink-only: edges move inward, never out.
JEV_EDGE_PIECE_SECS=5
JEV_EDGE_THRESHOLD=0.5
JEV_EDGE_CONTEXT_SECS=90
