# Copy to .env and fill in. Never commit real keys.
# Listening port
PORT=8787

# Primary Jev backend: TypeSafe direct (reliable quota; needs your key).
# Model jev-latest always tracks the newest release.
JEV_PRIMARY_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_PRIMARY_MODEL=jev-latest
JEV_PRIMARY_API_KEY=
# TYPESAFE_API_KEY is also accepted as a fallback name.

# Secondary Jev backend: OpenCode Zen (jev-1.13-free is free and keyless;
# used only if primary fails or rate-limits).
JEV_SECONDARY_BASE_URL=https://opencode.ai/zen/v1/systemone
JEV_SECONDARY_MODEL=jev-1.13-free
JEV_SECONDARY_API_KEY=

# Optional third backend. Unset by default: the slot is skipped and the
# primary -> secondary order is unchanged. Set it to add a provider without
# displacing the keyless free tier above.
# Cloudflare Workers AI (Clef) example:
#   JEV_TERTIARY_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/run/@cf/cloudflare/clef
#   JEV_TERTIARY_MODEL=clef
JEV_TERTIARY_BASE_URL=
JEV_TERTIARY_MODEL=
JEV_TERTIARY_API_KEY=

# Per-backend timeout
JEV_TIMEOUT_SECS=60

# Detection runs in two stages with separate thresholds.
#
# Stage 1, RECALL: decides only whether a candidate exists. Keep it low.
# A span rejected here is never reconsidered, so a strict recall gate loses
# whole ads rather than merely widening cuts. The label must also be a paid
# sponsor (paid_ad / host_read_sponsor / inserted_ad), which is what keeps
# sign-offs, ordinary talk, and the show promoting itself out.
JEV_RECALL_THRESHOLD=0.35
# Deprecated alias for JEV_RECALL_THRESHOLD. Still read, but now sets only the
# recall gate, so leaving it set will make cuts larger than you expect.
# JEV_AD_THRESHOLD=0.5
#
# Stage 2, EDGE TRIM: re-judges the first and last ~6s of each cut as ~2s
# pieces and moves the bounds inward. A piece survives only when noul clears
# this AND its label is a paid sponsor. Shrink-only: it can tighten a cut but
# never grow one.
JEV_EDGE_THRESHOLD=0.50
JEV_EDGE_PIECE_SECS=2
JEV_EDGE_CONTEXT_SECS=45

# A weaker paid-sponsor neighbor joins a candidate when noul >= this and the
# gap is at most JEV_ATTACH_GAP_SECS, so one read is one cut.
JEV_ATTACH_THRESHOLD=0.40
JEV_ATTACH_GAP_SECS=8
# Reviewer confirms the candidate if noul >= threshold, else rejects it.
JEV_REVIEW_THRESHOLD=0.5

# Transcript grouping / batching / concurrency.
# Spans flush around the target, never grow past the max, and break on a pause.
# If MAX is below TARGET, the proxy raises max to the target and logs a warning
# at startup. Otherwise a 20s target with an 8s max silently produces 8s spans.
# Max parallel Jev calls: MinusPod fires all windows at once, so this plus
# backoff is what keeps free-tier backends from burst-limiting.
JEV_SEGMENT_TARGET_SECS=4
JEV_SEGMENT_MAX_SECS=8
JEV_SEGMENT_GAP_SECS=1.25
JEV_MAX_SEGMENTS_PER_CALL=16
JEV_MAX_CONCURRENT_REQS=4

# When a backend returns 402 / billing, skip it for this many seconds.
# Daily quota (Clef code 4006, Zen FreeUsageLimitError) is skipped until the
# next 00:00 UTC instead. When every configured backend is in one of those
# states, the proxy pauses the MinusPod container and does not poll. The next
# real request after unpause is the probe. JEV_CLIENT_TIMEOUT_SECS is
# MinusPod's per-call timeout (600s for openai-compatible with no
# llm_timeout_seconds). The in-flight request is held only when the wait fits
# inside that budget.
JEV_BILLING_DEAD_SECS=1800
JEV_CLIENT_TIMEOUT_SECS=600
JEV_HOLD_MARGIN_SECS=30
JEV_MINUSPOD_CONTAINER=minuspod
JEV_DOCKER_SOCKET=/var/run/docker.sock
